#!/bin/sh
# Sentinel: refuse any commit that would publish a key, a token or a private working file (DECISIONS.md 57).
# Installed with:  git config core.hooksPath .githooks
PY=/Library/Frameworks/Python.framework/Versions/3.13/bin/python3
[ -x "$PY" ] || PY=python3
exec "$PY" sentinel_validate.py --secrets --staged
